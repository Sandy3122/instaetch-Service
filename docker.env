# Docker-specific environment configuration
NODE_ENV=production
PORT=3000

# Security
JWT_SECRET=your-jwt-secret-here
API_KEY_SECRET=your-api-key-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Instagram Scraper Configuration - Optimized for Docker
INSTAGRAM_USER_AGENT=Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0.0.0 Mobile Safari/537.36
INSTAGRAM_TIMEOUT=120000

# Proxy Configuration
USE_PROXY=true
PROXY_RETRIES=3

# Cache Configuration
CACHE_TTL=86400
CACHE_CHECK_PERIOD=600

# Logging
LOG_LEVEL=info
LOG_MEDIA=false
LOG_SESSION=true
LOG_INTERCEPT=false

# CORS - Allow all origins in production
ALLOWED_ORIGINS=*

# ScraperAPI (if using)
SCRAPER_API_KEY=your-scraper-api-key-here
SCRAPER_API_URL=https://api.scraperapi.com 